<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:OyiEditor.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="960" d:DesignHeight="600"
        x:Class="OyiEditor.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="OyiEditor"
        Width="960" Height="600">

  <Design.DataContext>
    <vm:MainViewModel />
  </Design.DataContext>

  <DockPanel>
    <Border DockPanel.Dock="Left" Width="240" Padding="12"
            BorderThickness="0,0,1,0" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
      <StackPanel Spacing="8">
        <TextBlock Text="Engine" FontWeight="SemiBold" />
        <TextBox PlaceholderText="Host" Text="{Binding Host}" IsEnabled="{Binding CanEditEndpoint}" />
        <NumericUpDown PlaceholderText="Port" Minimum="1" Maximum="65535" Increment="1" FormatString="0"
                       Value="{Binding Port}" IsEnabled="{Binding CanEditEndpoint}" />
        <Button Content="Connect" HorizontalAlignment="Stretch" Command="{Binding ConnectCommand}" />
        <Button Content="Disconnect" HorizontalAlignment="Stretch" Command="{Binding DisconnectCommand}" />
        <TextBlock Text="{Binding Status}" Opacity="0.7" TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <DockPanel Margin="12">
      <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
        <Button DockPanel.Dock="Right" Content="Send" Margin="8,0,0,0"
                Command="{Binding SendCommand}" IsDefault="True" />
        <TextBox PlaceholderText="Command, e.g. ping   or   echo -- hello" Text="{Binding CommandLine}"
                 FontFamily="Consolas, Menlo, monospace" />
      </DockPanel>
      <ListBox x:Name="LogList" ItemsSource="{Binding Log}" FontFamily="Consolas, Menlo, monospace" />
    </DockPanel>
  </DockPanel>
</Window>
